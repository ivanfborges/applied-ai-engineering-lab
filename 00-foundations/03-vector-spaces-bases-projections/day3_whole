# 8. Practical Python example

The following example projects a vector in (\mathbb{R}^3) onto a two-dimensional subspace.

The basis is intentionally non-orthogonal.

```python
from __future__ import annotations

import numpy as np


def main() -> None:
    # The columns of A span a two-dimensional subspace of R^3.
    A = np.array(
        [
            [1.0, 1.0],
            [1.0, 0.0],
            [0.0, 1.0],
        ]
    )

    x = np.array([3.0, 1.0, 2.0])

    # Solve min ||x - A @ coefficients||_2.
    # Prefer this over explicitly computing an inverse.
    coefficients, residual_sum, rank, singular_values = np.linalg.lstsq(
        A,
        x,
        rcond=None,
    )

    projected_x = A @ coefficients
    residual = x - projected_x

    print("Original vector:")
    print(x)

    print("\nCoordinates in the subspace basis:")
    print(coefficients)

    print("\nProjected vector:")
    print(projected_x)

    print("\nResidual:")
    print(residual)

    print("\nA.T @ residual should be approximately zero:")
    print(A.T @ residual)

    print("\nRank:")
    print(rank)

    print("\nSingular values:")
    print(singular_values)

    # Create an orthonormal basis for the same column space.
    Q, _ = np.linalg.qr(A)

    projection_matrix = Q @ Q.T
    projected_with_qr = projection_matrix @ x

    print("\nProjection using Q @ Q.T:")
    print(projected_with_qr)

    print("\nProjection matrix is symmetric:")
    print(np.allclose(projection_matrix.T, projection_matrix))

    print("\nProjection matrix is idempotent:")
    print(
        np.allclose(
            projection_matrix @ projection_matrix,
            projection_matrix,
        )
    )

    print("\nBoth approaches agree:")
    print(np.allclose(projected_x, projected_with_qr))


if __name__ == "__main__":
    main()
```

The important checks are:

[
A^\top r\approx0
]

[
P^\top=P
]

[
P^2=P
]

The least-squares and QR-based methods should produce the same projection.

Very small outputs such as:

```text
1.11022302e-16
```

are floating-point approximations of zero.

