# 9. From-scratch implementation

This implementation demonstrates classical Gram–Schmidt and projection onto an orthonormal basis.

```python
from __future__ import annotations

import numpy as np


def gram_schmidt(
    vectors: np.ndarray,
    tolerance: float = 1e-10,
) -> np.ndarray:
    """
    Convert column vectors into an orthonormal basis.

    Parameters
    ----------
    vectors:
        Matrix with shape (n_dimensions, n_vectors).
        Each column is a candidate basis vector.
    tolerance:
        Minimum accepted norm after removing prior projections.

    Returns
    -------
    np.ndarray
        Matrix Q whose columns form an orthonormal basis.
    """
    if vectors.ndim != 2:
        raise ValueError("vectors must be a two-dimensional matrix.")

    orthonormal_vectors: list[np.ndarray] = []

    for column_index in range(vectors.shape[1]):
        candidate = vectors[:, column_index].astype(float).copy()

        for basis_vector in orthonormal_vectors:
            coefficient = np.dot(basis_vector, candidate)
            candidate -= coefficient * basis_vector

        candidate_norm = np.linalg.norm(candidate)

        if candidate_norm < tolerance:
            raise ValueError(
                "Input vectors are linearly dependent or nearly dependent."
            )

        orthonormal_vectors.append(candidate / candidate_norm)

    return np.column_stack(orthonormal_vectors)


def project_onto_subspace(
    vector: np.ndarray,
    orthonormal_basis: np.ndarray,
) -> np.ndarray:
    coordinates = orthonormal_basis.T @ vector
    return orthonormal_basis @ coordinates


def main() -> None:
    basis = np.array(
        [
            [1.0, 1.0],
            [1.0, 0.0],
            [0.0, 1.0],
        ]
    )

    vector = np.array([3.0, 1.0, 2.0])

    Q = gram_schmidt(basis)
    projected = project_onto_subspace(vector, Q)
    residual = vector - projected

    print("Orthonormal basis Q:")
    print(Q)

    print("\nQ.T @ Q:")
    print(Q.T @ Q)

    print("\nProjected vector:")
    print(projected)

    print("\nResidual:")
    print(residual)

    print("\nResidual orthogonality check:")
    print(Q.T @ residual)


if __name__ == "__main__":
    main()
```

This is educational rather than production-grade.

Classical Gram–Schmidt may lose orthogonality when vectors are nearly dependent.

More stable alternatives include:

* modified Gram–Schmidt;
* Householder QR;
* SVD.

